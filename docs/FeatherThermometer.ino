static void drawBig(int16_t x, int16_t y, uint8_t idx) {
  if (idx >= GLYPH_COUNT) return;
  display.drawBitmap(x, y, GLYPH32[idx], BIG_W, BIG_H, SH110X_WHITE);
}

static void drawSmall(int16_t x, int16_t y, uint8_t idx) {
  if (idx >= GLYPH_COUNT) return;
  display.drawBitmap(x, y, GLYPH16[idx], SM_W, SM_H, SH110X_WHITE);
}

/* =========================================================================
 * Screens
 * ====================================================================== */

/* Bluetooth rune, 8x16, MSB = leftmost pixel. Built from strokes rather than
 * traced by eye: a full-height stem at column 3, two flags on the right
 * (stem top -> col 6 -> back), and the two 45-degree diagonals that run past
 * the stem and cross each other at column 1-2.
 *
 *     ...#....  ...##...  ...#.#..  ...#..#.  ...#.#..  ...##...
 *     #..#....  .###....  .###....  #..#....  ...##...  ...#.#..
 *     ...#..#.  ...#.#..  ...##...  ...#....
 */
static const uint8_t BT_ICON[BT_ICON_H] PROGMEM = {
  0x10, 0x18, 0x14, 0x12, 0x14, 0x18, 0x90, 0x70,
  0x70, 0x90, 0x18, 0x14, 0x12, 0x14, 0x18, 0x10
};

static void drawBluetoothIcon(int16_t x, int16_t y) {
  display.drawBitmap(x, y, BT_ICON, BT_ICON_W, BT_ICON_H, SH110X_WHITE);
}

/* How many of the ten interior rows to fill. Rounds to nearest, so 0-4% is
 * empty and 95-100% is full. */
static uint8_t battFillRows(uint8_t pct) {
  if (pct > 100) pct = 100;
  uint8_t n = (uint8_t)((pct + 5) / 10);
  return (n > BATT_ICON_LEVELS) ? BATT_ICON_LEVELS : n;
}

/* Battery icon: 3 px terminal nub on the top row, then a 7x12 single-pixel
 * outline enclosing a 5x10 interior, filled from the bottom up. Drawn with
 * primitives rather than eleven bitmaps because the fill is the only part
 * that changes. */
static void drawBatteryIcon(int16_t x, int16_t y, uint8_t pct) {
  display.drawFastHLine(x + 2, y, 3, SH110X_WHITE);          /* nub      */
  display.drawRect(x, y + 1, BATT_ICON_W, 12, SH110X_WHITE); /* outline  */

  const uint8_t n = battFillRows(pct);
  if (n > 0) {
    /* Interior spans rows y+2 .. y+11; the fill is bottom-aligned in it. */
    display.fillRect(x + 1, y + 12 - n, 5, n, SH110X_WHITE);
  }
}

static void drawStatusIcons(bool connected, uint8_t pct) {
  if (connected) drawBluetoothIcon(BT_ICON_X, BT_ICON_Y);
  drawBatteryIcon(BATT_ICON_X, BATT_ICON_Y, pct);
}

/* Render the whole screen: temperature plus the status icons. Cells are
 * filled right-to-left so the value is right-aligned against the decimal
 * point. */
static void drawMainScreen(bool valid, int16_t tenths, bool connected,
                           uint8_t pct) {
  if (!haveDisplay) return;
  display.clearDisplay();
  drawStatusIcons(connected, pct);

  if (!valid) {
    /* No reading yet, or the probe has gone away: leave the digit area
     * blank. The battery icon already shows the unit is powered. */
    display.display();
    return;
  }

  const bool    negative = (tenths < 0);
  const int32_t mag      = negative ? -(int32_t)tenths : (int32_t)tenths;
  int32_t       whole    = mag / 10;
  const uint8_t frac     = (uint8_t)(mag % 10);

  /* Clamp to what the three-cell field can show. */
  if (negative && whole > 99)   whole = 99;
  if (!negative && whole > 999) whole = 999;

  /* Build the integer cells, right-aligned. -1 means "blank". */
  int8_t  cell[3] = { -1, -1, -1 };
  int8_t  idx     = 2;
  int32_t v       = whole;
  do {
    cell[idx--] = (int8_t)(v % 10);
    v /= 10;
  } while (v > 0 && idx >= 0);

  if (negative && idx >= 0) {
    cell[idx] = (int8_t)GLYPH_MINUS;
  }

  for (uint8_t i = 0; i < 3; i++) {
    if (cell[i] >= 0) drawBig(BIG_X0 + i * BIG_W, BIG_Y, (uint8_t)cell[i]);
  }

  drawSmall(DP_X, SM_Y, GLYPH_DOT);
  drawSmall(SM_X, SM_Y, frac);

  display.display();
}

static void displayOff() {
  if (!haveDisplay) return;
  display.clearDisplay();
  display.display();
  display.oled_command(SH110X_DISPLAYOFF);   /* 0xAE - stops the OLED bias */
}

/* =========================================================================
 * Battery
 * ====================================================================== */
static uint8_t readBatteryPercent() {
  if (!haveGauge) return 0;
  float p = maxlipo.cellPercent();
  if (isnan(p) || p < 0.0f) p = 0.0f;
  if (p > 100.0f)           p = 100.0f;      /* the MAX17048 can report >100 */
  return (uint8_t)lroundf(p);
}

/* =========================================================================
 * Encoding helpers
 * ====================================================================== */
static int16_t currentTempCenti() {
  if (!tempValid) return TEMP_INVALID;
  float scaled = tempC * 100.0f;
  if (scaled >  32767.0f) scaled =  32767.0f;
  if (scaled < -32767.0f) scaled = -32767.0f;
  return (int16_t)lroundf(scaled);
}

static void putU16(uint8_t *p, uint16_t v) {
  p[0] = (uint8_t)(v & 0xFF);
  p[1] = (uint8_t)(v >> 8);
}

static void buildManufacturerData(uint8_t *out) {
  putU16(&out[0], BLE_COMPANY_ID);
  putU16(&out[2], rtcSeq);
  putU16(&out[4], (uint16_t)currentTempCenti());
  out[6] = batteryPct;
  out[7] = rtcPressCount;
}

static void buildMeasurement(uint8_t *out) {
  putU16(&out[0], rtcSeq);
  putU16(&out[2], (uint16_t)currentTempCenti());
  out[4] = batteryPct;
  out[5] = rtcPressCount;
  out[6] = (uint8_t)((haveProbe ? 0x01 : 0x00) | (btn.pressed ? 0x02 : 0x00));
  out[7] = 0;
}

/* =========================================================================
 * BLE
 * ====================================================================== */
class ServerCallbacks : public NimBLEServerCallbacks {
  void onConnect(NimBLEServer *srv, NimBLEConnInfo &info) override {
    bleConnected  = true;
    bleConnHandle = info.getConnHandle();
    /* Ask for a relaxed interval: this is a 1.3 Hz sensor, there is nothing
     * to gain from a 15 ms connection interval. Units are 1.25 ms, so
     * 24..40 is 30..50 ms; latency 4 lets the peripheral skip events. */
    srv->updateConnParams(info.getConnHandle(), 24, 40, 4, 400);
  }

  void onDisconnect(NimBLEServer *srv, NimBLEConnInfo &info, int reason) override {
    (void)srv; (void)info; (void)reason;
    bleConnected = false;
    NimBLEDevice::startAdvertising();
  }
};

static void bleBegin() {
  NimBLEDevice::init(BLE_DEVICE_NAME);

  pServer = NimBLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());

  /* --- Environmental Sensing: works with off-the-shelf BLE apps --- */
  NimBLEService *ess = pServer->createService("181A");
  chrEssTemp = ess->createCharacteristic(
      "2A6E", NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::NOTIFY);
  ess->start();

  /* --- Battery Service --- */
  NimBLEService *bas = pServer->createService("180F");
  chrBattLvl = bas->createCharacteristic(
      "2A19", NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::NOTIFY);
  bas->start();

  /* --- Custom service: the whole sample in one packet --- */
  NimBLEService *svc = pServer->createService(UUID_SVC);
  chrMeas = svc->createCharacteristic(
      UUID_MEAS, NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::NOTIFY);
  svc->start();

  /* Seed the values so a read before the first sample returns something
   * well-formed rather than an empty attribute. */
  uint8_t meas[8];
  buildMeasurement(meas);
  chrMeas->setValue(meas, sizeof(meas));

  int16_t tc = currentTempCenti();
  chrEssTemp->setValue((uint8_t *)&tc, sizeof(tc));
  chrBattLvl->setValue(&batteryPct, 1);

  /* --- Advertising --- */
  uint8_t mfg[8];
  buildManufacturerData(mfg);

  pAdv = NimBLEDevice::getAdvertising();
  pAdv->setConnectableMode(BLE_GAP_CONN_MODE_UND);
  pAdv->setName(BLE_DEVICE_NAME);
  pAdv->addServiceUUID(NimBLEUUID((uint16_t)0x181A));
  pAdv->setManufacturerData(mfg, sizeof(mfg));

  /* Units of 0.625 ms: 160 = 100 ms, 240 = 150 ms. */
  pAdv->setMinInterval(160);
  pAdv->setMaxInterval(240);

  pAdv->start();
  bleUp = true;
}

/* Refresh the beacon payload. Only meaningful while advertising, which is
 * to say while nothing is connected. */
static void bleRefreshBeacon() {
  if (!bleUp || pAdv == nullptr || bleConnected) return;
  uint8_t mfg[8];
  buildManufacturerData(mfg);
  pAdv->setManufacturerData(mfg, sizeof(mfg));
  pAdv->refreshAdvertisingData();
}

static void bleEnd() {
  if (!bleUp) return;

  /* Clear the flag first so nothing can publish into a stack that is being
   * dismantled. */
  bleUp = false;

  if (pAdv != nullptr) pAdv->stop();

  if (bleConnected && pServer != nullptr) {
    pServer->disconnect(bleConnHandle);   /* clean close, not a timeout */
    /* Let the disconnect actually go out and the callback run before any
     * attribute is freed underneath the host task. */
    for (uint8_t i = 0; i < 20 && bleConnected; i++) delay(10);
  }

#if BLE_DEINIT_BEFORE_SLEEP
  NimBLEDevice::deinit(true);
#endif

  pServer    = nullptr;
  pAdv       = nullptr;
  chrMeas    = nullptr;
  chrEssTemp = nullptr;
  chrBattLvl = nullptr;
}

/* Push the current sample out. Called once per completed conversion, and
 * again on a button press so the press count does not wait for the next
 * sample. */
static void publishSample() {
  if (!bleUp) return;

  uint8_t meas[8];
  buildMeasurement(meas);
  chrMeas->setValue(meas, sizeof(meas));

  int16_t tc = currentTempCenti();
  chrEssTemp->setValue((uint8_t *)&tc, sizeof(tc));
  chrBattLvl->setValue(&batteryPct, 1);

  if (bleConnected) {
    chrMeas->notify();
    chrEssTemp->notify();
    chrBattLvl->notify();
  } else {
    bleRefreshBeacon();
  }
}

/* =========================================================================
 * Button
 * ====================================================================== */
static ButtonEvent pollButton() {
  const bool     raw = (digitalRead(PIN_BUTTON) == LOW);
  const uint32_t now = millis();

  if (raw != btn.lastRaw) {
    btn.lastRaw    = raw;
    btn.lastChange = now;
  }

  if ((now - btn.lastChange) >= DEBOUNCE_MS && raw != btn.pressed) {
    btn.pressed = raw;
    if (raw) {
      btn.pressStart = now;
      btn.longFired  = false;
    } else {
      if (btn.eatRelease) {
        btn.eatRelease = false;          /* release of the power-on hold */
      } else if (!btn.longFired) {
        return BTN_SHORT;
      }
    }
  }

  if (btn.pressed && !btn.longFired && (now - btn.pressStart) >= LONG_PRESS_MS) {
    btn.longFired = true;
    return BTN_LONG;
  }
  return BTN_NONE;
}

/* =========================================================================
 * Power
 * ====================================================================== */
static void setButtonLed(bool on) {
#if USE_BUTTON_LED
  digitalWrite(PIN_BUTTON_LED, on ? HIGH : LOW);
#else
  (void)on;
#endif
}

/* Block until the button has read released continuously for
 * BUTTON_SETTLE_MS. Any LOW sample restarts the window, so release bounce
 * cannot satisfy it the way a single digitalRead() could. No timeout: if the
 * button is stuck down, waiting here is correct - arming a level-triggered
 * wake against a closed contact just wakes the chip straight back up. */
static void waitButtonSettled() {
  uint32_t since = millis();
  while ((millis() - since) < BUTTON_SETTLE_MS) {
    if (digitalRead(PIN_BUTTON) == LOW) since = millis();
    delay(5);
  }
}

static void goToSleep() {
  /* Record the intent before anything else. If the teardown below crashes,
   * the next boot reads this, sees that we meant to switch off, and goes
   * back to sleep instead of powering up. */
  rtcPwrMagic = PWR_MAGIC;
  rtcPwrState = PWR_STATE_OFF;

  /* Blank the screen first. At a long press this happens the moment the
   * threshold is reached, which is the user's cue to let go, rather than
   * after BLE teardown. */
  displayOff();
  setButtonLed(false);
  bleEnd();

  /* Shed everything the deep-sleep domain does not need. */
#if USE_BUTTON_LED
  pinMode(PIN_BUTTON_LED, INPUT);
#endif
#ifdef NEO_PWR_PIN
  pinMode(NEO_PWR_PIN, OUTPUT);
  digitalWrite(NEO_PWR_PIN, LOW);
#endif
  pinMode(I2C_PWR_PIN, OUTPUT);
  digitalWrite(I2C_PWR_PIN, LOW);       /* kills the QT rail and I2C pull-ups */

  waitButtonSettled();

  /* rtc_gpio_init() switches the pad from the digital GPIO peripheral to the
   * RTC domain. Without it the RTC pull-up below can be ignored, leaving the
   * pin floating through deep sleep - and a floating wake pin drifts low and
   * wakes the chip for no reason. */
  rtc_gpio_init((gpio_num_t)PIN_BUTTON);
  rtc_gpio_set_direction((gpio_num_t)PIN_BUTTON, RTC_GPIO_MODE_INPUT_ONLY);
  rtc_gpio_pulldown_dis((gpio_num_t)PIN_BUTTON);
  rtc_gpio_pullup_en((gpio_num_t)PIN_BUTTON);

  esp_sleep_enable_ext0_wakeup((gpio_num_t)PIN_BUTTON, 0);

  esp_deep_sleep_start();
  /* Never returns; the next boot starts at setup(). */
}

/* Block until the button has been held for 'ms', or return false as soon as
 * it is genuinely released.
 *
 * The mirror image of waitButtonSettled(), and it needs the same care: a
 * single raw digitalRead() would abort a real long press on make bounce. So
 * a HIGH sample only counts as a release once it has persisted for
 * DEBOUNCE_MS, and a brief bounce neither aborts the hold nor restarts its
 * timer. */
static bool buttonHeldFor(uint32_t ms) {
  const uint32_t start = millis();
  bool           releasing = false;
  uint32_t       releaseAt = 0;

  while ((millis() - start) < ms) {
    if (digitalRead(PIN_BUTTON) == LOW) {
      releasing = false;
    } else if (!releasing) {
      releasing = true;
      releaseAt = millis();
    } else if ((millis() - releaseAt) >= DEBOUNCE_MS) {
      return false;
    }
    delay(5);
  }
  return true;
}

/* Seed the button tracker as already-pressed with longFired set, so the
 * release of the starting press is swallowed rather than counted as a short
 * press, and continuing to hold cannot fire a long press and switch straight
 * back off. The user has to release and press again for either to
 * register. */
static void consumeWakePress() {
  btn.pressed    = true;
  btn.lastRaw    = true;
  btn.lastChange = millis();
  btn.pressStart = millis();
  btn.longFired  = true;
  btn.eatRelease = true;
}

/* =========================================================================
 * Temperature acquisition (non-blocking)
 * ====================================================================== */
static void startConversion() {
  if (!haveProbe) return;
  sensors.requestTemperatures();      /* setWaitForConversion(false) is set */
  convStartedAt = millis();
  convPending   = true;
}

/* Returns true when a fresh reading has landed in tempC / tempValid.
 *
 * The DS18B20 guarantees the conversion is finished within DS_CONVERT_MS, so
 * a timed wait is enough - polling isConversionComplete() every few ms would
 * put pointless traffic on the bus with interrupts masked each time. */
static bool serviceConversion() {
  if (!haveProbe || !convPending) return false;
  if ((millis() - convStartedAt) < DS_CONVERT_MS) return false;

  const float c = sensors.getTempC(probeAddr);
  convPending   = false;

  /* -127 is the library's disconnected marker. 85.0 exactly is the DS18B20
   * power-on scratchpad default, i.e. a conversion that never happened. */
  if (c == DEVICE_DISCONNECTED_C || c <= -100.0f || c >= 200.0f) {
    tempValid = false;
  } else {
    /* Calibration is applied here, at the single point where a reading
     * enters the system, so the display and the BLE payload cannot
     * disagree about what the temperature is. The sanity check above
     * deliberately runs on the raw value. */
    tempC     = c * CAL_SCALE + CAL_OFFSET;
    tempValid = true;
  }

  startConversion();                  /* immediately queue the next one */
  return true;
}

/* Key used to decide whether the screen actually needs repainting. */
static int32_t temperatureKey() {
  if (!tempValid) return INT32_MIN + 1;
  return (int32_t)lroundf(tempC * 10.0f);
}

/* Repaint only when something visible actually changed. The battery is
 * compared at icon resolution, not percent, so a 71 -> 70 reading does not
 * cost a redraw. */
static void repaintIfChanged() {
  const int32_t key  = temperatureKey();
  const bool    conn = bleConnected;
  const uint8_t rows = battFillRows(batteryPct);
  if (key == drawnKey && conn == drawnConnected && rows == drawnBattRows) return;
  drawMainScreen(tempValid, (int16_t)(tempValid ? key : 0), conn, batteryPct);
  drawnKey       = key;
  drawnConnected = conn;
  drawnBattRows  = rows;
}

/* =========================================================================
 * setup / loop
 * ====================================================================== */
void setup() {
  Serial.begin(115200);

  pinMode(PIN_BUTTON, INPUT_PULLUP);
#if USE_BUTTON_LED
  pinMode(PIN_BUTTON_LED, OUTPUT);
  digitalWrite(PIN_BUTTON_LED, LOW);
#endif

  /* Boot diagnostics go into RTC memory, not out of the port. Over native
   * USB the host has not reopened the port this early after a wake, so
   * printing here would be lost. bootLogDump() runs from loop() once the
   * monitor attaches. */
  const esp_sleep_wakeup_cause_t wakeCause = esp_sleep_get_wakeup_cause();
  const bool coldBoot = (rtcPwrMagic != PWR_MAGIC);

#if DEBUG_BOOT_LOG
  if (coldBoot) {
    memset(rtcBootLog, 0, sizeof(rtcBootLog));
    rtcBootSeq = 0;
  }
  bootLogAppend((uint8_t)esp_reset_reason(), (uint8_t)wakeCause,
                coldBoot ? 0 : (rtcPwrState == PWR_STATE_OFF ? 2 : 1));
#endif

  if (wakeCause == ESP_SLEEP_WAKEUP_EXT0) {
    /* Button wake. Require the same hold as switching off, before spending
     * any power on the display, sensor or radio.
     *
     * millis() here is roughly the time since the wake edge, so subtracting
     * it makes the hold the user actually performs match LONG_PRESS_MS
     * rather than LONG_PRESS_MS plus however long boot took. */
    const uint32_t sinceWake = millis();
    const uint32_t remaining =
        (sinceWake >= LONG_PRESS_MS) ? 0 : (LONG_PRESS_MS - sinceWake);
    if (!buttonHeldFor(remaining)) {
      goToSleep();                              /* does not return */
    }
    consumeWakePress();
  } else if (!coldBoot && rtcPwrState == PWR_STATE_OFF) {
    /* Not a button wake, and the last thing we did was decide to switch off.
     * So this is a spurious reset - a crash on the way to sleep, a watchdog,
     * a brownout - and it must NOT be treated as a request to power on.
     * Straight back to sleep. Almost nothing is initialised at this point,
     * so this second attempt has very little left to trip over. The record
     * appended above is what tells you afterwards that this happened. */
    goToSleep();                                /* does not return */
  }
  /* Otherwise: cold boot, USB plug or the reset button while on. Power up,
   * which keeps development sane. */

  rtcPwrMagic = PWR_MAGIC;
  rtcPwrState = PWR_STATE_ON;

  /* Bring up the switchable I2C rail before touching the bus. */
  pinMode(I2C_PWR_PIN, OUTPUT);
  digitalWrite(I2C_PWR_PIN, HIGH);
  delay(50);

  Wire.begin();

  delay(250);                                   /* let the OLED come up */
  haveDisplay = display.begin(0x3C, true);
  if (haveDisplay) {
    display.setRotation(1);                     /* -> 128 wide x 64 tall */
    display.clearDisplay();
    display.display();
  } else {
    Serial.println(F("SH1107 not found"));
  }

  haveGauge = maxlipo.begin(&Wire);
  if (!haveGauge) Serial.println(F("MAX17048 not found"));

  sensors.begin();
  haveProbe = (sensors.getDeviceCount() > 0) && sensors.getAddress(probeAddr, 0);
  if (haveProbe) {
    sensors.setResolution(probeAddr, DS_RESOLUTION);
    sensors.setWaitForConversion(false);
    startConversion();
  } else {
    Serial.println(F("DS18B20 not found - check the 4.7k pull-up"));
  }

  setButtonLed(true);

  delay(100);                                   /* fuel gauge settling */
  batteryPct    = readBatteryPercent();
  lastBatteryAt = millis();

  bleBegin();

  /* Paint immediately. The first conversion is still ~750 ms away, so this
   * shows dashes plus the battery icon until it lands. */
  repaintIfChanged();
}

void loop() {
  const uint32_t now = millis();

#if DEBUG_BOOT_LOG
  /* Serial's bool operator tracks whether the host has the CDC port open, so
   * this fires whenever the monitor attaches - however long that takes after
   * a wake, and immediately if it was already open. */
  static bool bootLogShown = false;
  if (!bootLogShown && Serial) {
    bootLogShown = true;
    bootLogDump();
  }
#endif

  /* ---- button ---- */
  switch (pollButton()) {
    case BTN_LONG:
      goToSleep();                              /* does not return */
      break;

    case BTN_SHORT:
      rtcPressCount++;                          /* wraps at 256, by design */
      publishSample();                          /* do not make the client wait */
      break;

    default:
      break;
  }

  /* ---- temperature ---- */
  if (serviceConversion()) {
    rtcSeq++;
    repaintIfChanged();
    publishSample();
  }

  /* ---- battery ---- */
  if ((now - lastBatteryAt) >= BATTERY_POLL_MS) {
    lastBatteryAt = now;
    const uint8_t p = readBatteryPercent();
    if (p != batteryPct) {
      batteryPct = p;                           /* icon redraws via repaint */
      if (bleUp && bleConnected && chrBattLvl != nullptr) {
        chrBattLvl->setValue(&batteryPct, 1);
        chrBattLvl->notify();
      } else {
        bleRefreshBeacon();
      }
    }
  }

  /* ---- connection state on the display ---- */
  repaintIfChanged();

  delay(5);
}
