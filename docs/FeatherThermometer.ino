/* -------------------------------------------------------------------------
 * Persisted across deep sleep so the client sees monotonic counters even
 * when the unit is switched off and on again. Zeroed on a cold boot.
 * ---------------------------------------------------------------------- */
RTC_DATA_ATTR static uint16_t rtcSeq        = 0;
RTC_DATA_ATTR static uint8_t  rtcPressCount = 0;

/* Power intent, deliberately RTC_NOINIT_ATTR rather than RTC_DATA_ATTR.
 *
 * RTC_DATA_ATTR is re-initialised by the startup code on a software or
 * watchdog reset; RTC_NOINIT_ATTR survives every reset except power-on. That
 * difference is the entire point here - we need to still know we were
 * shutting down even if the shutdown itself crashed. Without it, any reset
 * during teardown falls through to the power-on path and the unit appears to
 * switch straight back on.
 *
 * NOINIT means the contents are undefined at power-on, hence the magic
 * value: if it does not match, this is a cold boot and the state word is
 * garbage. */
#define PWR_MAGIC       0x54484D31UL   /* 'THM1' */
#define PWR_STATE_ON    0xA5A5A5A5UL
#define PWR_STATE_OFF   0x5A5A5A5AUL

RTC_NOINIT_ATTR static uint32_t rtcPwrMagic;
RTC_NOINIT_ATTR static uint32_t rtcPwrState;

/* ---- Boot log -----------------------------------------------------------
 * Deep sleep powers the USB peripheral down, so the host closes the port and
 * anything printed early in setup() after a wake goes nowhere: the monitor
 * has not re-enumerated and reopened the port yet. Printing live is simply
 * not possible over native USB across a sleep cycle.
 *
 * So each boot appends a record here instead, in RTC memory that survives
 * both deep sleep and a crash, and the whole history is dumped the moment
 * the serial monitor actually attaches. The record for a failed shutdown
 * therefore appears on the FOLLOWING boot - switch off, switch on, wait for
 * the monitor, read the log.
 *
 * For live output across sleep, use a UART instead: a USB-serial adapter on
 * TX (GPIO39) and RX (GPIO38) keeps the port open because it belongs to the
 * adapter, not to the ESP32. Print to Serial0 rather than Serial in that
 * case.
 * ---------------------------------------------------------------------- */
#define DEBUG_BOOT_LOG   1
#define BOOT_LOG_COUNT   8

typedef struct __attribute__((packed)) {
  uint8_t seq;      /* boot counter, wraps at 256                        */
  uint8_t reset;    /* esp_reset_reason()                                */
  uint8_t wake;     /* esp_sleep_get_wakeup_cause()                      */
  uint8_t prior;    /* 0 = cold boot, 1 = was ON, 2 = was shutting down  */
} BootRecord;

RTC_NOINIT_ATTR static BootRecord rtcBootLog[BOOT_LOG_COUNT];
RTC_NOINIT_ATTR static uint8_t    rtcBootSeq;

