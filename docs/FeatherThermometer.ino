#if DEBUG_BOOT_LOG
static const char *resetName(uint8_t r) {
  switch (r) {
    case ESP_RST_POWERON:   return "POWERON";
    case ESP_RST_EXT:       return "EXT_PIN";
    case ESP_RST_SW:        return "SW_RESTART";
    case ESP_RST_PANIC:     return "PANIC";
    case ESP_RST_INT_WDT:   return "INT_WDT";
    case ESP_RST_TASK_WDT:  return "TASK_WDT";
    case ESP_RST_WDT:       return "OTHER_WDT";
    case ESP_RST_DEEPSLEEP: return "DEEPSLEEP";
    case ESP_RST_BROWNOUT:  return "BROWNOUT";
    default:                return "UNKNOWN";
  }
}

static const char *wakeName(uint8_t w) {
  switch (w) {
    case ESP_SLEEP_WAKEUP_EXT0:  return "EXT0";
    case ESP_SLEEP_WAKEUP_TIMER: return "TIMER";
    case ESP_SLEEP_WAKEUP_UNDEFINED: return "-";
    default:                     return "other";
  }
}

static const char *priorName(uint8_t p) {
  return (p == 0) ? "cold" : (p == 1 ? "was ON" : "was OFF");
}

static void bootLogAppend(uint8_t reset, uint8_t wake, uint8_t prior) {
  BootRecord *r = &rtcBootLog[rtcBootSeq % BOOT_LOG_COUNT];
  r->seq   = rtcBootSeq;
  r->reset = reset;
  r->wake  = wake;
  r->prior = prior;
  rtcBootSeq++;
}

/* Oldest first. A DEEPSLEEP reset with prior "was OFF" is a clean off/on
 * cycle. A PANIC, watchdog or BROWNOUT with prior "was OFF" means the
 * shutdown crashed rather than slept, and the fail-safe caught it - look at
 * BLE_DEINIT_BEFORE_SLEEP first. */
static void bootLogDump() {
  Serial.println("---- boot log, oldest first ----");
  const uint8_t n = (rtcBootSeq < BOOT_LOG_COUNT) ? rtcBootSeq : BOOT_LOG_COUNT;
  for (uint8_t i = 0; i < n; i++) {
    const uint8_t     idx = (uint8_t)((rtcBootSeq - n + i) % BOOT_LOG_COUNT);
    const BootRecord *r   = &rtcBootLog[idx];
    Serial.printf("  #%-3u reset=%-10s wake=%-5s prior=%s\n",
                  r->seq, resetName(r->reset), wakeName(r->wake),
                  priorName(r->prior));
  }
  Serial.println("--------------------------------");
}
#endif /* DEBUG_BOOT_LOG */

