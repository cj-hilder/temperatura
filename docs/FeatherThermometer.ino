/* How long the button must read released before we commit to deep sleep.
 * EXT0 is level-triggered, so a contact that re-closes after we have armed
 * it wakes the chip instantly. Must comfortably exceed release bounce. */
static const uint32_t BUTTON_SETTLE_MS = 150;
static const uint32_t BATTERY_POLL_MS  = 10000; /* fuel gauge re-read period  */

/* DS18B20 conversion time by resolution:
 *   9-bit  ~94 ms (0.5 degC)   10-bit ~188 ms (0.25 degC)
 *  11-bit ~375 ms (0.125 degC) 12-bit ~750 ms (0.0625 degC)
 * We display one decimal place, so 11-bit is enough if you want a faster
 * refresh; 12-bit is the default here for best noise behaviour. */
static const uint8_t  DS_RESOLUTION    = 12;
static const uint32_t DS_CONVERT_MS    = 750;

/* ---- Probe calibration ---------------------------------------------------
 * Two-point linear correction:  corrected = raw * CAL_SCALE + CAL_OFFSET
 *
 * The DS18B20 is factory trimmed and has no calibration registers, so this
 * corrects the residual error of one specific probe. Re-derive it if the
 * probe is ever replaced.
 *
 * MVP LIMITATION - THESE CONSTANTS ARE HARD CODED FOR ONE SENSOR.
 * In the shipping product, calibration belongs in the mobile app: the user
 * performs the ice and boiling measurements with the app prompting for
 * station pressure, the app computes scale and offset, and writes them to
 * the Feather over BLE. That needs a writable calibration characteristic on
 * the custom service (see the BLE INTERFACE block above) and the pair
 * persisted in NVS so it survives a power cycle and a firmware update. The
 * two constants below then become defaults, used only until the app has
 * written real ones. Until that exists, this build is tied to the specific
 * probe measured below and must not be shipped with a different one.
 *
 * Measured on this unit:
 *   ice slush   raw -0.2   true   0.0
 *   boiling     raw 98.7   true  99.6
 *
 * True boiling is not 100. It was 99.6 at the time of measurement: sea-level
 * pressure 1001 hPa, less ~1.8 hPa for 15 m of elevation, gives ~999 hPa
 * station pressure, and water boils at roughly 0.028 degC per hPa below the
 * 100 degC / 1013 hPa reference.
 *
 *   CAL_SCALE  = (trueBoil - trueIce) / (rawBoil - rawIce)
 *              = (99.6 - 0.0) / (98.7 - -0.2) = 99.6 / 98.9 = 1.00708
 *   CAL_OFFSET = trueIce - rawIce * CAL_SCALE
 *              = 0.0 - (-0.2 * 1.00708) = +0.201
 *
 * A single offset was not enough: the error is -0.2 at the ice point and
 * -0.9 at boiling, so it is a slope error. Offsetting by +0.2 to fix the ice
 * point alone would leave boiling reading 98.9.
 *
 * To disable, set CAL_SCALE to 1.0f and CAL_OFFSET to 0.0f.
 *
 * Repeating the calibration:
 *   1. Crushed or shaved ice with just enough water to slush, stirred, probe
 *      immersed at least 60 mm. This is the trustworthy point - it is inside
 *      the sensor's +/-0.5 degC band and does not depend on the weather.
 *   2. Boiling water, same immersion, and look up the station pressure at
 *      the time. Note the datasheet only claims +/-2 degC above 85 degC, so
 *      this end of the curve is the weaker of the two.
 * ---------------------------------------------------------------------- */
static const float    CAL_SCALE        = 1.00708f;
static const float    CAL_OFFSET       = 0.201f;

/* Tear the BLE stack down before deep sleep, or just stop it and sleep.
 * deinit() frees every service and characteristic, which is the tidy thing
 * to do but is also the most likely place for a crash on the way to sleep -
 * a notify in flight on the host task becomes a use-after-free. Deep sleep
 * powers the radio down regardless, so 0 is a safe fallback if the reset
 * reason logged at boot ever points here. */
#define BLE_DEINIT_BEFORE_SLEEP  1

#define BLE_COMPANY_ID       0xFFFF     /* SIG "internal use" - replace       */
#define BLE_DEVICE_NAME      "FTHERM"

#define UUID_SVC     "b7e1c0a0-4f3d-4a21-9f3e-6c1a2d5b7e01"
#define UUID_MEAS    "b7e1c0a0-4f3d-4a21-9f3e-6c1a2d5b7e02"

static const int16_t  TEMP_INVALID     = INT16_MIN;   /* 0x8000 sentinel      */

/* -------------------------------------------------------------------------
 * Display geometry (128x64 after setRotation(1))
 *
 * Digits are Spleen bitmaps (see the licence block at the top of the file),
 * not drawn shapes. Spleen ships fixed cells that match the spec exactly:
 * 32x64 for the integer digits and 16x32 for the tenths.
 *
 *   col:  0        32       64       96   112      128
 *         +--------+--------+--------+----+----+
 *   row 0  |        |        |        | BT | BAT |   <- status icons
 *          | 32x64  | 32x64  | 32x64  |----+----|
 *          |  cell0 |  cell1 |  cell2 | .  | 5  |
 *          |        |        |        |16x32 16x32
 *   row 63 +--------+--------+--------+----+----+
 *
 *   Three 32 px cells plus two 16 px cells is exactly 128 px, so the layout
 *   fills the width with no fudging.
 *
 *   The two 16 px cells sit at y=26, and the tallest ink in them starts at
 *   row 32, which leaves the 32x32 block at x>=96, y<32 free. The status
 *   icons live there. They are kept inside rows 0..16 so they clear the
 *   nominal cell boundary at row 26, not just the ink.
 *
 *   Integer field is right-aligned across the three big cells:
 *     "125.6" -> [1][2][5] . [6]
 *     "-15.2" -> [-][1][5] . [2]
 *     "-5.0"  -> [ ][-][5] . [0]
 *
 *   Ink inside the cells: a 32x64 digit inks rows 12..51, a 16x32 digit inks
 *   rows 6..25. Putting the small cells at y=26 lands both baselines on row
 *   51, which is what SM_Y below is for. Do not change one without the other.
 * ---------------------------------------------------------------------- */
#define SCREEN_W        128
#define SCREEN_H        64

#define BIG_W           32      /* Spleen 32x64 cell */
#define BIG_H           64
#define BIG_X0          0
#define BIG_Y           0

#define SM_W            16      /* Spleen 16x32 cell */
#define SM_H            32
#define SM_Y            26      /* aligns the small baseline with the big one */
#define DP_X            96      /* the '.' cell   */
#define SM_X            112     /* the tenths cell */

#define GLYPH_MINUS     10      /* index into the glyph tables */
#define GLYPH_DOT       11
#define GLYPH_COUNT     12

/* Status icons, top right. Bluetooth is 8x16 at x=110..117, battery is 7x13
 * at x=120..126, with a 2 px gap between them and col 127 left as margin.
 * The battery is offset down 2 px so the two icons look centred on each
 * other despite the height difference. */
#define BT_ICON_X       110
#define BT_ICON_Y       0
#define BT_ICON_W       8
#define BT_ICON_H       16

#define BATT_ICON_X     120
#define BATT_ICON_Y     2
#define BATT_ICON_W     7       /* 1 px outline, 5 px wide interior */
#define BATT_ICON_H     13      /* 1 px nub + 12 px body           */
#define BATT_ICON_LEVELS 10     /* interior is 10 px tall: one row per 10% */

