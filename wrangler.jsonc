{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temperatura",
  // Server code is limited to /api/* (the Google token endpoint). See the
  // run_worker_first comment below.
  "main": "worker/index.js",
  "routes": [
    {
      "pattern": "temperatura.hilderbuild.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-09-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker. Everything else is served from dist/ as
    // before. /api/* must be listed here, not left to fall through: with the
    // SPA fallback above, a missing /api path would otherwise get index.html
    // with a 200.
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
